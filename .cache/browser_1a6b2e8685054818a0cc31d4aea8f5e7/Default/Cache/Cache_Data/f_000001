:root {
  --ink: #142d3d;
  --muted: #607584;
  --line: #dce5e9;
  --surface: #ffffff;
  --canvas: #f4f7f8;
  --accent: #087b76;
  --accent-dark: #06625e;
  --radius: 16px;
  font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
  color: var(--ink);
  background: var(--canvas);
  font-synthesis: none;
}
.batch-form { padding-block: 20px; border-bottom: 1px solid var(--line); }
.batch-evidence { padding: 16px; overflow-wrap: anywhere; }
#batch-results .policy-table { min-width: 1100px; }
.batch-run { white-space: normal; }
.findings-card { margin: 20px 0; border-left: 4px solid var(--accent); }
.finding { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
.finding h3 { font-size: 14px; }
.demo-result { margin-top: 28px; }
.demo-result p, .demo-result h3 { margin-top: 14px; }
select { max-width: 100%; width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; margin: 12px 0; }
* { box-sizing: border-box; }
body { margin: 0; font-size: 15px; line-height: 1.65; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
button, input { font: inherit; }
button, a, input, summary { -webkit-tap-highlight-color: transparent; }
:focus-visible { outline: 3px solid #65bdb8; outline-offset: 4px; }
[hidden] { display: none !important; }
h1, h2, h3, p { margin: 0; }
h1, h2, h3 { line-height: 1.25; }
.container { width: min(1160px, calc(100% - 64px)); margin-inline: auto; }
.site-header { background: var(--surface); border-bottom: 1px solid var(--line); }
.header-inner { display: flex; justify-content: space-between; align-items: center; padding-block: 22px; gap: 20px; }
.brand { display: flex; align-items: center; gap: 12px; color: var(--ink); }
.brand:hover { text-decoration: none; }
.brand strong { display: block; font-size: 20px; letter-spacing: .025em; line-height: 1.2; }
.brand-caption { display: block; color: var(--muted); font-size: 11px; margin-top: 3px; }
.brand-mark { display: grid; place-items: center; background: var(--ink); color: #fff; width: 44px; height: 48px; border-radius: 11px; }
.brand-mark svg { width: 29px; height: 29px; }
.local-label { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; }
.local-label > span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
.skip-link { position: fixed; top: -100px; left: 20px; padding: 12px 20px; background: white; z-index: 10; border: 1px solid var(--accent); }
.skip-link:focus { top: 12px; }
.eyebrow { color: var(--muted); font-size: 10px; letter-spacing: .14em; font-weight: 700; text-transform: uppercase; }
.home-hero { padding: 72px 0 36px; text-align: center; }
.home-hero > .eyebrow { color: var(--accent); margin-bottom: 20px; }
.home-hero h1 { font-size: clamp(34px, 4.5vw, 56px); font-weight: 700; line-height: 1.09; letter-spacing: -.045em; }
.accent-dot { color: var(--accent); }
.hero-description { max-width: 750px; margin: 22px auto 0; color: var(--muted); font-size: 16px; line-height: 1.9; }
.scan-card { max-width: 870px; margin: 0 auto; background: var(--surface); padding: 32px; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 12px 36px #193b4d06; }
.scan-heading { display: flex; align-items: flex-start; gap: 15px; margin-bottom: 26px; }
.scan-heading h2 { font-size: 18px; }
.scan-heading p { margin-top: 6px; font-size: 13px; color: var(--muted); }
.step-number { background: #e7f3f1; color: var(--accent); font-size: 12px; font-weight: 700; padding: 7px 10px; border-radius: 7px; }
label { display: block; font-size: 12px; font-weight: 650; margin-bottom: 9px; }
.input-row { display: flex; gap: 12px; }
input { width: 100%; min-width: 0; background: #fafcfc; border: 1px solid #bdccd3; border-radius: 9px; padding: 13px 16px; color: var(--ink); font-size: 16px; }
input::placeholder { color: #8b9ca7; }
input[aria-invalid="true"] { border-color: #b84143; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 15px; cursor: pointer; border: 1px solid transparent; border-radius: 9px; padding: 13px 20px; font-size: 12px; font-weight: 650; white-space: nowrap; }
.button:hover { text-decoration: none; }
.button-primary { background: var(--accent); color: white; }
.button-primary:hover { background: var(--accent-dark); }
.button:disabled { background: #638d89; cursor: wait; }
.button-arrow { font-size: 18px; font-weight: 400; line-height: 1; }
.input-help { color: var(--muted); font-size: 11px; margin-top: 12px; }
code, .mono, .data-value { font-family: Consolas, "SFMono-Regular", Menlo, monospace; }
.form-error { color: #a52935; margin-top: 12px; font-size: 13px; }
.scan-progress { padding: 12px 15px; border-left: 3px solid var(--accent); background: #edf7f5; color: var(--accent-dark); margin-top: 17px; font-size: 13px; }
.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 35px; max-width: 870px; margin: 40px auto 76px; }
.feature-number { color: #7a909c; font-size: 9px; font-weight: 650; letter-spacing: .08em; }
.feature-grid h3 { font-size: 15px; margin: 9px 0 7px; }
.feature-grid p { color: var(--muted); font-size: 12px; line-height: 1.85; }
.notice { border-radius: 9px; padding: 15px 18px; border: 1px solid; margin-bottom: 20px; font-size: 13px; overflow-wrap: anywhere; }
.notice p { margin-top: 5px; }
.notice-error { background: #fff0f0; border-color: #efc6c8; color: #962c37; }
.notice-warning { background: #fff8e9; border-color: #ead29b; color: #805e0b; }
.site-footer { border-top: 1px solid var(--line); padding: 25px 0; display: flex; gap: 15px; justify-content: space-between; color: #748895; font-size: 10px; }
.result-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-top: 28px; }
.back-link { font-size: 12px; font-weight: 600; }
.result-hero { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin: 28px 0 30px; }
.result-hero h1 { font-size: clamp(26px, 3.3vw, 40px); letter-spacing: -.035em; margin: 9px 0; overflow-wrap: anywhere; }
.runtime { display: flex; gap: 12px; color: var(--muted); font-size: 12px; }
.runtime .mono { color: var(--ink); }
.final-block { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; flex-shrink: 0; }
.final-result .badge { font-size: 16px; padding: 9px 18px; }
.card { min-width: 0; padding: 27px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 23px; }
.card-heading .eyebrow { margin-bottom: 8px; font-size: 9px; }
.card-heading h2 { font-size: 19px; letter-spacing: -.015em; }
.card-number { font: 15px Consolas, monospace; color: #bdcbd2; }
.badge { display: inline-block; border: 1px solid; padding: 3px 9px; border-radius: 6px; font-size: 10px; line-height: 1.5; font-weight: 700; letter-spacing: .04em; white-space: nowrap; }
.status-pass { color: #166b4c; background: #edf8f1; border-color: #c2e4d1; }
.status-warning { color: #8b620c; background: #fff6df; border-color: #e8d19a; }
.status-fail { color: #ae303f; background: #fff0f2; border-color: #efc5cd; }
.status-neutral { color: #697786; background: #f0f3f5; border-color: #d5dde2; }
.summary-card { border-top: 3px solid var(--accent); margin-bottom: 25px; }
.summary-checks { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
.summary-checks > div { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; padding-right: 10px; }
.summary-checks > div > span:first-child { font-size: 11px; font-weight: 550; color: var(--muted); }
.summary-reasons { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
.summary-reasons h3 { font-size: 12px; }
.summary-reasons p { color: var(--muted); font-size: 12px; margin-top: 9px; }
.reasons { padding-left: 18px; margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.9; overflow-wrap: anywhere; }
.section-nav { display: flex; flex-wrap: wrap; gap: 6px; margin: 20px 0; }
.section-nav a { color: var(--muted); padding: 6px 13px; border: 1px solid var(--line); border-radius: 6px; background: #ffffff80; font-size: 11px; }
.section-nav a:hover { border-color: #89b9b6; color: var(--accent); text-decoration: none; }
.result-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.full-width { grid-column: 1 / -1; }
.kv-list { margin: 0; }
.kv-row { display: grid; grid-template-columns: minmax(135px, .8fr) minmax(0, 1.5fr); gap: 15px; padding: 11px 0; border-bottom: 1px solid #edf1f3; }
.kv-row:last-child { border-bottom: none; }
.kv-row dt { font-size: 11px; color: var(--muted); }
.kv-row dd { margin: 0; min-width: 0; font-size: 12px; overflow-wrap: anywhere; }
.data-value { font-size: 11px; color: #294556; }
.check-message { font-size: 12px; padding-top: 12px; color: var(--muted); }
.san-details { margin-top: 17px; border: 1px solid var(--line); border-radius: 8px; }
summary { cursor: pointer; padding: 10px 14px; font-size: 12px; font-weight: 600; }
.count-label { color: var(--muted); margin-left: 9px; font-weight: 400; }
.san-list { list-style: none; margin: 0; padding: 0 14px 10px; max-height: 185px; overflow-y: auto; font: 11px/1.9 Consolas, monospace; overflow-wrap: anywhere; }
.san-list li { padding: 5px 0; border-top: 1px solid #edf1f3; }
.empty-state { color: var(--muted); font-size: 12px; padding: 10px 0; }
.san-details .empty-state { padding: 0 14px 12px; }
.chain-length { font-size: 12px; color: var(--muted); }
.chain-length strong { margin-left: 12px; font-family: Consolas, monospace; color: var(--ink); }
.chain-list { list-style: none; padding: 0; margin: 20px 0; }
.chain-list li { display: flex; align-items: flex-start; gap: 15px; padding: 15px 0; border-bottom: 1px solid #edf1f3; }
.chain-list li > div { min-width: 0; overflow-wrap: anywhere; }
.chain-index { color: var(--accent); background: #eaf4f2; min-width: 28px; height: 28px; border-radius: 6px; display: grid; place-items: center; font: 11px Consolas, monospace; }
.chain-role { color: var(--muted); font-size: 10px; font-weight: 600; }
.chain-subject { font: 12px/1.7 Consolas, monospace; margin: 5px 0; }
.chain-issuer, .chain-dates { color: var(--muted); font-size: 10px; line-height: 1.8; }
.check-grid, .sct-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 30px; }
.policy-meta { display: flex; flex-wrap: wrap; gap: 18px 35px; font-size: 11px; color: var(--muted); background: #f6f9f9; border-radius: 7px; padding: 14px 17px; }
.policy-meta strong { margin-left: 9px; color: var(--ink); font-family: Consolas, monospace; }
.rule-list { margin: 13px 0; }
.rule { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; padding: 15px 0; border-bottom: 1px solid #edf1f3; }
.rule h3 { font-size: 12px; }
.rule p { color: var(--muted); font-size: 11px; margin-top: 5px; overflow-wrap: anywhere; }
.ct-metrics { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 20px; margin-bottom: 22px; }
.ct-metrics > div { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
.ct-metrics > div > span:first-child { color: var(--muted); font-size: 11px; }
.ct-metrics strong { font: 25px Consolas, monospace; }
.interval-note { font-size: 11px; color: var(--muted); margin-bottom: 20px; }
.sct-card { background: #fafcfc; border: 1px solid var(--line); border-radius: 10px; padding: 20px; margin: 15px 0; }
.sct-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 12px; }
.sct-heading h3 { font-size: 14px; }
.sct-grid .kv-row { grid-template-columns: minmax(145px, 1fr) minmax(0, 1.5fr); }
.result-bottom { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 30px 0 48px; }
.result-bottom > span { font-size: 11px; color: var(--muted); }
section[id] { scroll-margin-top: 25px; }
.home-hero h1 { font-size: clamp(25px, 3.5vw, 43px); line-height: 1.3; letter-spacing: -.025em; }
.feature-grid article { background: var(--surface); padding: 22px; border: 1px solid var(--line); border-radius: 12px; }
.brand-mark { flex-shrink: 0; }
.verdict-explanation { color: var(--muted); font-size: 13px; margin: -12px 0 24px; }
.overview { margin: 20px 0; }
.summary-checks > .overview-item { padding: 20px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
.summary-checks > .overview-item > .overview-icon { font-size: 24px; color: var(--accent); }
.score-card { display: flex; gap: 28px; align-items: center; justify-content: space-between; padding: 25px 28px; border: 1px solid #bdd7d3; border-left: 4px solid var(--accent); background: #edf6f4; border-radius: 12px; }
.score-card h2 { font-size: 19px; }
.score-card p { color: var(--muted); font-size: 12px; max-width: 680px; margin-top: 8px; }
.score-card .score-help { font-size: 11px; }
.score-value { min-width: 125px; flex-shrink: 0; color: var(--accent-dark); }
.score-value strong { font-size: 40px; font-weight: 700; }
.score-value span { font-size: 15px; margin-left: 5px; }
.score-value meter { display: block; width: 100%; height: 12px; }
.spinner { width: 17px; height: 17px; border: 2px solid #ffffff55; border-top-color: white; border-radius: 50%; animation: spin .8s linear infinite; flex-shrink: 0; }
@keyframes spin { to { transform: rotate(360deg); } }
.technical-details { margin: 8px 0; border-left: 2px solid var(--line); }
.technical-details summary { padding: 4px 12px; color: var(--muted); font-size: 11px; }
.technical-details pre { white-space: pre-wrap; overflow-wrap: anywhere; font: 11px/1.8 Consolas, monospace; margin: 6px 12px; max-height: 180px; overflow-y: auto; }
.san-preview { list-style: none; padding: 0; font: 11px/1.9 Consolas, monospace; overflow-wrap: anywhere; }
#hostname h3, #cryptography h3 { font-size: 12px; color: var(--accent); margin: 16px 0 9px; }
.chain-timeline { position: relative; }
.chain-timeline li { position: relative; border-bottom: none; padding-bottom: 28px; }
.chain-timeline li:not(:last-child)::before { content: ''; position: absolute; left: 13px; top: 43px; bottom: -15px; width: 2px; background: #b5d8d1; }
.chain-timeline li:not(:last-child)::after { content: '↓'; position: absolute; left: 8px; bottom: 0; color: var(--accent); background: white; }
.chain-timeline .chain-index { position: relative; z-index: 1; border-radius: 50%; border: 1px solid #b5d8d1; }
.chain-role { font-size: 12px; color: var(--accent-dark); }
.chain-subject { max-width: 850px; }
.chain-timeline .chain-subject { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chain-timeline li > div { width: calc(100% - 43px); }
.node-status { display: block; font-size: 11px; margin-top: 8px; color: var(--muted); }
.table-scroll { overflow-x: auto; width: 100%; }
.policy-table { border-collapse: collapse; width: 100%; min-width: 580px; text-align: left; font-size: 12px; }
.policy-table th, .policy-table td { padding: 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
.policy-table thead { background: #edf6f4; }
.policy-table th[scope='row'] { width: 28%; font-weight: 600; }
.policy-table .check-message { padding-top: 7px; }
.policy-fail { background: #fff0f2; }
.sct-accordion { padding: 0; }
.sct-accordion > summary { padding: 18px 20px; margin: 0; }
.sct-accordion > summary::before { content: '+'; color: var(--accent); font-size: 20px; }
.sct-accordion[open] > summary::before { content: '−'; }
.sct-accordion > dl, .sct-accordion > ul { margin: 0 20px 20px; }
.sct-accordion > summary > span:first-of-type { margin-right: auto; }
.summary-final { padding-top: 20px; font-size: 14px; }
.summary-final .badge { margin-left: 12px; }
abbr[title] { text-decoration: underline dotted; cursor: help; }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
@media (max-width: 640px) {
  .score-card { flex-direction: column; align-items: flex-start; padding: 20px; }
  .score-value { width: 100%; }
  .header-inner { flex-wrap: wrap; }
  .sct-heading { flex-wrap: wrap; }
  .card-heading { flex-wrap: wrap; }
}
@media (max-width: 900px) {
  .summary-checks { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .sct-grid, .check-grid { grid-template-columns: 1fr; }
  .kv-row { grid-template-columns: minmax(100px, .8fr) minmax(0, 1.4fr); }
  .site-footer { flex-direction: column; gap: 5px; }
}
@media (max-width: 640px) {
  .container { width: calc(100% - 32px); }
  .header-inner { padding-block: 16px; }
  .local-label { font-size: 10px; }
  .brand-caption { font-size: 9px; }
  .home-hero { padding-top: 48px; }
  .hero-description { font-size: 14px; }
  .desktop-break { display: none; }
  .scan-card { padding: 23px 20px; }
  .input-row { flex-direction: column; }
  .input-row .button { min-height: 49px; }
  .feature-grid { grid-template-columns: 1fr; gap: 24px; margin-bottom: 45px; }
  .feature-grid article { border-bottom: 1px solid var(--line); padding-bottom: 20px; }
  .result-hero { flex-direction: column; align-items: flex-start; }
  .final-block { align-items: flex-start; gap: 7px; }
  .result-toolbar > .eyebrow { display: none; }
  .result-grid { grid-template-columns: 1fr; }
  .card { padding: 22px 18px; }
  .summary-checks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ct-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ct-metrics > div:last-child { grid-column: 1 / -1; }
  .sct-card { padding: 15px 12px; }
  .sct-grid .kv-row { grid-template-columns: minmax(105px, 1fr) minmax(0, 1.4fr); gap: 10px; }
  .result-bottom { flex-direction: column; align-items: stretch; }
}
