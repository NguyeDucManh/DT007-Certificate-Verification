/* Restrained blue/cyan surfaces; status colors always follow the engine badge. */
.site-header {
  background: linear-gradient(110deg, #eef5ff, #ffffff 58%, #ecfaff);
  border-bottom-color: #c8dcf5;
  box-shadow: 0 3px 16px #1e3a8a08;
}
.brand-mark { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
.local-label a[aria-current=page] { background: #dbeafe; color: #1e40af; }
.home-hero, .page-heading {
  background: linear-gradient(115deg, #e8f1ff, #f1faff 65%, #e5f7fc);
  border: 1px solid #d0e3fa;
  border-radius: 18px;
  padding: 32px 28px;
  margin-bottom: 24px;
}
.home-hero h1, .page-heading h1 { color: #162f6c; }
.scan-card {
  border-color: #c8dcf5;
  border-top: 3px solid #3b82f6;
  box-shadow: 0 8px 28px #1e3a8a0b;
}
.step-number { background: #dbeafe; color: #1e40af; }
.button-primary { background: #1d4ed8; box-shadow: 0 3px 9px #1d4ed822; }
.button-primary:hover { background: #1e40af; }
.button-secondary { background: #f4f8ff; border-color: #bcd3f2; color: #1e3a8a; }
.button-secondary:hover { background: #e2eeff; border-color: #8eb6eb; }
input[type=text], select { background: #fbfdff; border-color: #bfd2ec; }
input[type=text]:focus, select:focus { background: #fff; box-shadow: 0 0 0 3px #dbeafe; }
.advanced-options {
  background: #f0f6ff;
  border: 1px solid #dbe7f5;
  border-radius: 10px;
  padding: 10px 14px;
}
.advanced-options[open] { background: #edf5ff; border-color: #bfd7f7; }
.optional-label { background: #fff; border-color: #c7dcf7; color: #36547c; }
.feature-grid { gap: 16px; }
.feature-grid article {
  background: #edf4ff;
  border: 1px solid #d2e2fa;
  border-top: 3px solid #60a5fa;
  border-radius: 12px;
  padding: 22px;
}
.feature-grid article:nth-child(2) { background: #edfafb; border-color: #c9e9ee; border-top-color: #38bdf8; }
.feature-grid article:nth-child(3) { background: #f1f3ff; border-color: #dcdff8; border-top-color: #818cf8; }
.feature-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  background: #dbeafe;
  border: 1px solid #c2d9fb;
  border-radius: 10px;
  color: #1e40af;
  font-size: 1.4rem;
  margin-bottom: 12px;
}
.feature-grid article:nth-child(2) .feature-icon { background: #cff3f8; border-color: #b7e7ee; color: #155e75; }
.feature-grid article:nth-child(3) .feature-icon { background: #e0e7ff; border-color: #cbd4fa; color: #3730a3; }
.site-footer {
  color: #38557d;
  border-top: 2px solid #c9dcf6;
  background: #ebf3ff;
  border-radius: 12px 12px 0 0;
  padding: 20px 22px;
}
.result-hero {
  background: #edf5ff;
  border: 1px solid #c5dcfa;
  border-left: 4px solid #3b82f6;
  border-radius: 14px;
  padding: 24px;
}
.result-hero[data-verdict=PASS] { background: #effbf3; border-color: #bbdfc8; border-left-color: #16a34a; }
.result-hero[data-verdict=WARNING] { background: #fffaeb; border-color: #efdcaa; border-left-color: #d97706; }
.result-hero[data-verdict=FAIL] { background: #fff2f2; border-color: #f1c9c9; border-left-color: #dc2626; }
.score-card { background: #eaf2ff; border-color: #bad3f9; border-top: 3px solid #2563eb; }
.score-card h2, .score-value strong { color: #1e3a8a; }
.score-card p { color: #38557d; font-size: .8rem; }
meter, meter::-webkit-meter-bar { background: #cdddff; }
.certificate-overview { border-top: 3px solid #93c5fd; }
.export-card {
  background: linear-gradient(125deg, #edf8ff, #f3fbfd);
  border-color: #bddfeb;
  border-top: 3px solid #0ea5e9;
}
.export-card .eyebrow { color: #155e75; }
.export-card .button { background: #fff; border-color: #afd2e6; color: #164e70; }
.export-card .button:hover { background: #dff3ff; }
.badge { font-size: .8rem; padding: 5px 10px; border: 1px solid transparent; }
.status-pass { background: #dcfce7; color: #166534; border-color: #b7e8c7; }
.status-warning { background: #fef3c7; color: #92400e; border-color: #f2d68e; }
.status-fail { background: #fee2e2; color: #991b1b; border-color: #f4bcbc; }
.status-neutral { background: #eaf0f7; color: #425571; border-color: #d2dfec; }
.badge[data-status=ERROR] { background: #fee9ed; color: #9f1239; border-color: #f7c2d0; }
.badge[data-status=UNKNOWN] { background: #e8eef6; color: #425571; border-color: #cbd8e9; }
.badge[data-status=NOT_CHECKED] { background: #eef2f7; color: #475569; border-color: #d6e0ec; }
.badge[data-status=NOT_VERIFIED] { background: #fff5dc; color: #7c5416; border-color: #ead7a4; }
.badge[data-status=UNSUPPORTED] { background: #e7f0f7; color: #365771; border-color: #c8dce9; }
.overview-item { background: #f0f6ff; border-color: #cbddf5; }
.overview-item:has([data-status=PASS]), .overview-item:has([data-status=VALID]), .overview-item:has([data-status=GOOD]) { background: #effbf3; border-color: #c8e8d2; }
.overview-item:has([data-status=WARNING]) { background: #fffae9; border-color: #efdfae; }
.overview-item:has([data-status=FAIL]), .overview-item:has([data-status=REVOKED]), .overview-item:has([data-status=INVALID]), .overview-item:has([data-status=ERROR]) { background: #fff2f2; border-color: #f0caca; }
.notice-warning { background: #fff4d4; border-color: #ecd28b; color: #7c4a0c; }
.notice-error { background: #fff0f0; border-color: #edc2c2; color: #991b1b; }
.notice-info { background: #e8f2ff; border-color: #c2d9fa; color: #244b7d; }
.section-heading h2 { color: #1e3a8a; }
.section-heading .eyebrow { color: #1d4ed8; }
.panel-icon { background: #dbeafe; border: 1px solid #bfd7fa; color: #1e40af; }
#identity-checks .panel-icon, #aia .panel-icon { background: #dcf5fa; border-color: #bce6ed; color: #155e75; }
#ct .panel-icon, #algorithm-checks .panel-icon { background: #e7eaff; border-color: #cdd4fa; color: #3730a3; }
#revocation .panel-icon { background: #fef3c7; border-color: #efdaa5; color: #92400e; }
.detail-panel { border-color: #d0e1f6; }
.detail-panel>summary:hover { background: #f0f6ff; }
.detail-panel[open] { border-color: #9dbfea; box-shadow: 0 3px 14px #1d4ed80a; }
.detail-panel[open]>summary { background: #edf5ff; border-radius: 12px 12px 0 0; }
.detail-panel[open]>.panel-body { border-color: #c8ddf7; }
.technical-details, .san-details, .sct-card { border-color: #cfdff2; }
.technical-details>summary, .san-details>summary, .sct-card>summary { background: #f2f7fd; border-radius: 8px; }
.ct-metrics>div { background: #ecf4ff; border-color: #cbdff7; }
.chain-index { background: #dbeafe; border-color: #b9d4f8; color: #1e40af; }
.demo-controls { background: #fafdff; }
.case-card { background: #fffaf4; border-color: #ecdeca; border-top: 3px solid #edc28f; }
.case-card:nth-child(3n+2) { background: #fdf7f7; border-color: #efdbdb; border-top-color: #e5abab; }
.case-card:nth-child(3n) { background: #f5f8ff; border-color: #d1def4; border-top-color: #8db4ed; }
.case-card:hover { border-color: #a2bfe6; box-shadow: 0 5px 18px #1e3a8a0c; }
.case-card .case-category { color: #5c6170; }
.case-number { background: #fff0d9; color: #8a4b16; }
.case-card:nth-child(3n+2) .case-number { background: #fbe5e5; color: #9b3941; }
.case-card:nth-child(3n) .case-number { background: #dbeafe; color: #1e40af; }
.case-card .button { background: #fff; }
.demo-verdicts>.card { background: #eff5ff; border-color: #bfd5f4; }
.demo-verdicts>.card:has(.status-fail) { background: #fff1f1; border-color: #eebebe; border-left: 4px solid #dc2626; }
.demo-verdicts>.card:has(.status-warning) { background: #fff8e5; border-color: #ecd9a6; border-left: 4px solid #d97706; }
.demo-verdicts>.card:has(.status-pass) { background: #edfbf2; border-color: #bce2c9; border-left: 4px solid #16a34a; }
.demo-result .ct-metrics>div:nth-child(2) { background: #ecfdf3; border-color: #c1e7ce; }
.demo-result .ct-metrics>div:nth-child(3) { background: #fff5ec; border-color: #ead9c8; }
thead th { background: #e9f2ff; color: #36547e; }
.policy-fail { background: #fff2f2; }
@media(max-width:700px) {
  .home-hero, .page-heading { padding: 24px 20px; }
  .feature-grid { gap: 12px; }
  .feature-grid article, .feature-grid article:last-child { padding: 20px; border: 1px solid #d2e2fa; border-top: 3px solid #60a5fa; }
  .feature-grid article:nth-child(2) { border-color: #c9e9ee; border-top-color: #38bdf8; }
  .feature-grid article:nth-child(3) { border-color: #dcdff8; border-top-color: #818cf8; }
  .result-hero { padding: 20px; }
  .badge, .final-result .badge, .ct-metrics .badge { font-size: .78rem; }
}
@media print{body{background:white}.site-header,.site-footer,.result-toolbar,.export-card,.result-bottom{display:none}.container{width:100%}.detail-panel{break-inside:avoid}.detail-panel>.panel-body{display:block!important}.card,.detail-panel{box-shadow:none}}
